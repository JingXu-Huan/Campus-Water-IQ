# Copy this file to .env for local Docker Compose overrides.
# .env is ignored by Git because it may contain local credentials.

TZ=Asia/Shanghai

MYSQL_ROOT_PASSWORD=change-me-local
MYSQL_PASSWORD=change-me-local

INFLUX_USERNAME=admin
INFLUX_PASSWORD=change-me-local
INFLUX_ORG=ncwu
INFLUX_BUCKET=water
INFLUX_TOKEN=replace-with-a-random-local-token

# 阿里云 OSS
OSS_ACCESS_KEY_ID=replace-with-aliyun-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-aliyun-access-key-secret

# 智谱 AI / GLM-4-plus，代码实际读取 API_KEY
API_KEY=replace-with-zhipu-api-key

SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MANAGEMENT_HEALTH_MAIL_ENABLED=false
